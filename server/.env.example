# =============================================================================
# Deadline API - server/.env.example
#
#   python -m scripts.init_env      creates .env with generated secrets (or: cp .env.example .env and fill it in)
#
# Legend
#   [REQUIRED]        the server refuses to start without it (see app/core/config.py)
#   [REQUIRED in prod] optional while ENVIRONMENT=development, enforced when ENVIRONMENT=production
#   [OPTIONAL]        feature is switched off (or a safe default is used) when unset
#
# Rules
#   * Never commit the real .env. Only this example file belongs in git.
#   * Empty values (KEY=) are treated as "not set".
#   * Quotes around values are allowed and stripped.
#   * Every secret below must be generated, never typed by hand. Generator for
#     all "random string" secrets:
#         python -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================


# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# [OPTIONAL] development | test | staging | production      (default: development)
# "production" turns on the strict checks: https-only origins, no localhost,
# email configured, API docs disabled.
ENVIRONMENT=development

# [OPTIONAL] DEBUG | INFO | WARNING | ERROR | CRITICAL      (default: INFO)
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------
# [REQUIRED in prod] default: mongodb://localhost:27017
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# URL-encode special characters in the password (@ -> %40, : -> %3A, / -> %2F).
MONGODB_URL=mongodb://localhost:27017

# [OPTIONAL] letters, digits, "_" and "-" only                (default: remindme)
DATABASE_NAME=remindme

# [OPTIONAL] how long to wait for the database at startup, in ms, 1000-60000 (default: 5000)
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000


# -----------------------------------------------------------------------------
# Authentication (JWT)
# -----------------------------------------------------------------------------
# [REQUIRED] at least 32 characters, no placeholder words, must differ from
# REMINDER_ENCRYPTION_KEY. There is deliberately NO default value.
# Rotating it logs every user out.
SECRET_KEY=

# [OPTIONAL] HS256 | HS384 | HS512                            (default: HS256)
ALGORITHM=HS256

# [OPTIONAL] 5-60. Access-token lifetime in minutes. Keep it short: the browser renews it silently
# with the refresh token, and a stolen access token stops working after this long.   (default: 15)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# [OPTIONAL] 1-90. How long a refresh token (the "stay logged in" credential) stays valid after its
# last use, in days. Every refresh issues a new one.                                  (default: 30)
REFRESH_TOKEN_EXPIRE_DAYS=30

# [OPTIONAL] 5-180. Minutes a password-reset link works (it also works only once).    (default: 60)
PASSWORD_RESET_EXPIRE_MINUTES=60


# -----------------------------------------------------------------------------
# Reminder encryption (AES-256-GCM, per-user keys derived from this master key)
# -----------------------------------------------------------------------------
# [REQUIRED] at least 32 characters. BACK THIS UP (password manager + offline copy).
# If it is lost, every stored reminder is unreadable. Never reuse SECRET_KEY.
REMINDER_ENCRYPTION_KEY=

# [OPTIONAL] comma-separated OLD keys, kept only while rotating. Each >= 32 chars.
# Rotation: move the current key here, put a new key above, then run
#   python -m scripts.encrypt_existing_tasks
REMINDER_ENCRYPTION_KEY_PREVIOUS=


# -----------------------------------------------------------------------------
# Web / CORS / links
# -----------------------------------------------------------------------------
# [REQUIRED in prod] origins allowed to call the API from a browser.
# Comma-separated (or a JSON array), scheme://host[:port], no path, no "*".
# Trailing slashes are removed. In development/test, any localhost port is also
# allowed automatically. In production every origin must be https and non-local.
#   production example: https://remindme.example.com,https://www.remindme.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# [REQUIRED in prod] public URL of the frontend. Used for password-reset links.
# Must be https and not localhost when ENVIRONMENT=production.  (default: http://localhost:5173)
FRONTEND_URL=http://localhost:5173


# -----------------------------------------------------------------------------
# Rate limiting (slowapi)
# -----------------------------------------------------------------------------
# Limits are counted in the server's own memory (no Redis needed). They reset on restart; use a single worker.

# [OPTIONAL] master switch. Keep true outside of automated tests.  (default: true)
RATE_LIMIT_ENABLED=true

# [OPTIONAL] "<count>/<second|minute|hour|day>"
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_SIGNUP=5/hour
RATE_LIMIT_FORGOT_PASSWORD=3/hour
RATE_LIMIT_MAGIC_ADD=10/hour
RATE_LIMIT_AVATAR=10/hour
RATE_LIMIT_RESET_PASSWORD=10/hour
RATE_LIMIT_REFRESH=60/minute
# [OPTIONAL] new link per hour (per user) / admin broadcast calls per minute (per IP)
RATE_LIMIT_TELEGRAM_LINK=10/hour
RATE_LIMIT_ADMIN=5/minute

# [OPTIONAL] 0-5. How many reverse proxies sit between the internet and this app and append to
# X-Forwarded-For (Render, Fly, Heroku, Railway: 1; Cloudflare in front of one of those: 2).
# 0 = ignore the header completely (correct when the app is exposed directly). Too high lets a
# caller spoof its IP and dodge the login / sign-up limits; too low counts every user as the proxy.
# Check with a request to a limited endpoint and look at which address gets throttled.  (default: 0)
TRUSTED_PROXY_HOPS=0

# [OPTIONAL] 16384-20971520. Largest request body accepted, in bytes (the avatar upload has its own
# 2 MB + overhead allowance).                                                          (default: 2097152)
MAX_REQUEST_BODY_BYTES=2097152

# Run uvicorn with --no-server-header so responses do not announce the server software:
#   uvicorn main:app --no-server-header


# -----------------------------------------------------------------------------
# Telegram reminders  (optional as a group: set the token and the rest becomes required)
# -----------------------------------------------------------------------------
# [OPTIONAL] token from @BotFather
TELEGRAM_BOT_TOKEN=

# [REQUIRED if TELEGRAM_BOT_TOKEN is set] bot username, with or without "@"
TELEGRAM_BOT_USERNAME=

# [REQUIRED if TELEGRAM_BOT_TOKEN is set] 32-256 characters from A-Z a-z 0-9 _ -
# Register it once (and again whenever it changes) so Telegram sends it back on every webhook call.
# Until you do, POST /telegram/webhook answers 403:
#   python -m scripts.set_telegram_webhook https://<your-api-host>/telegram/webhook
# (token_urlsafe output only contains characters Telegram accepts.)
TELEGRAM_WEBHOOK_SECRET=

# [OPTIONAL] numeric Telegram chat id allowed to run /broadcast (digits, may start with "-")
ADMIN_TELEGRAM_ID=

# [OPTIONAL] shared secret for POST /admin/broadcast (header X-Admin-Key). >= 32 chars.
# Leave empty to disable the HTTP broadcast endpoint.
ADMIN_SECRET=

# [OPTIONAL] 2-60. Minutes a "Connect Telegram" link stays valid (it also works only once).   (default: 10)
TELEGRAM_LINK_TTL_MINUTES=10


# -----------------------------------------------------------------------------
# Transactional email (Brevo) - password reset and confirmation
# -----------------------------------------------------------------------------
# [REQUIRED in prod] without it nobody can reset a password.
BREVO_API_KEY=

# [REQUIRED if BREVO_API_KEY is set] a sender address verified in Brevo
# (use an address on your own domain with SPF/DKIM, not a personal Gmail)
EMAIL_SENDER_ADDRESS=

# [OPTIONAL] display name                                     (default: Deadline)
EMAIL_SENDER_NAME=Deadline


# -----------------------------------------------------------------------------
# Web Push (VAPID)
# -----------------------------------------------------------------------------
# All three or none. Generate once:   npx web-push generate-vapid-keys
# The PUBLIC key also goes into client/.env as VITE_VAPID_PUBLIC_KEY.
#
# Optional: without them the server runs normally and the "enable alerts" button reports that push is not configured.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# contact address push services may use; "mailto:" prefix optional
VAPID_EMAIL=


# -----------------------------------------------------------------------------
# Google Gemini ("magic add")
# -----------------------------------------------------------------------------
# [OPTIONAL] without keys, POST /tasks/magic-add returns 503 and everything else works.
# Comma-separated list; keys are rotated round-robin on rate limits.
GEMINI_API_KEYS=
# [OPTIONAL] single-key alternative, merged with the list above
GEMINI_API_KEY=
# [OPTIONAL] comma-separated model names, best/fastest first. Empty = built-in list
# in utils/gemini_pool.py. Verify names against Google's current model list.
GEMINI_MODELS=
# [OPTIONAL] per-attempt timeout in seconds, 1-120            (default: 20)
GEMINI_TIMEOUT_SECONDS=20


# -----------------------------------------------------------------------------
# Reminder delivery: scheduler, HTTP client, web push limits
# -----------------------------------------------------------------------------
# [OPTIONAL] true/false. Run the reminder scheduler inside this process. Several API workers/instances may all
# keep it on (claims and slot locks make delivery happen once). Set false on instances that should only serve API
# calls.                                                                                       (default: true)
SCHEDULER_ENABLED=true
# [OPTIONAL] 1-50. Telegram / push deliveries running at the same time.                          (default: 10)
SCHEDULER_CONCURRENCY=10
# [OPTIONAL] 1-60 seconds, timeout of every outbound call (Telegram, Brevo).                     (default: 10)
HTTP_TIMEOUT_SECONDS=10
# [OPTIONAL] 5-500. Size of the shared outbound connection pool.                                 (default: 50)
HTTP_MAX_CONNECTIONS=50
# [OPTIONAL] 1-50. Devices (push subscriptions) one user may register.                           (default: 10)
MAX_PUSH_SUBSCRIPTIONS=10
# [OPTIONAL] true/false. Also accept Microsoft Edge's push service (*.notify.windows.com). Google, Mozilla and
# Apple endpoints are always accepted; nothing else ever is.                                     (default: true)
PUSH_ALLOW_WINDOWS=true

# -----------------------------------------------------------------------------
# API surface, delta sync, password hashing
# -----------------------------------------------------------------------------
# [OPTIONAL] true/false. Keep the old un-versioned routes (/tasks, /user/updates, /telegram/*, /webpush/*,
# /admin/broadcast) mounted next to /v1 so deployed clients keep working. Turn off once every client uses /v1.
#                                                                                              (default: true)
LEGACY_API_ENABLED=true
# [OPTIONAL] 1-365. Days a deleted reminder is remembered (tombstone) so other devices can learn about the delete.
# A device offline for longer gets 410 full_resync_required and downloads everything again.     (default: 30)
TOMBSTONE_RETENTION_DAYS=30
# [OPTIONAL] Page size of GET /v1/tasks when the client sends no limit (10-500), and the largest size it may ask
# for (10-1000).                                                                      (default: 200 / 500)
SYNC_DEFAULT_PAGE_SIZE=200
SYNC_MAX_PAGE_SIZE=500
# [OPTIONAL] 0-60 seconds. The sync cursor trails "now" by this much so a change committed slightly late is
# never skipped; the overlap is re-sent and harmless (idempotent).                               (default: 5)
SYNC_SAFETY_WINDOW_SECONDS=5
# [OPTIONAL] 1-16. Password hashes (argon2/bcrypt) computed at the same time per process, in worker threads.
# Keeps a login burst from using every thread and starving the event loop.                       (default: 4)
PASSWORD_HASH_CONCURRENCY=4

# -----------------------------------------------------------------------------
# Performance
# -----------------------------------------------------------------------------
# [OPTIONAL] Connection pool to MongoDB. A few warm connections avoid a TCP+TLS handshake on the first request after
# a quiet moment; idle ones are recycled before a proxy drops them.            (defaults: 30 / 2 / 45000 ms)
MONGODB_MAX_POOL_SIZE=30
MONGODB_MIN_POOL_SIZE=2
MONGODB_MAX_IDLE_MS=45000
# [OPTIONAL] true/false. zlib compression between this API and MongoDB.                         (default: true)
MONGODB_COMPRESSION=true
# [OPTIONAL] Requests slower than this many ms are logged as one WARNING line; every response also carries a
# Server-Timing header you can read in the browser's Network tab.                              (default: 1500)
SLOW_REQUEST_MS=1500
# [OPTIONAL] JSON responses larger than this many bytes are gzip-compressed.                    (default: 1024)
GZIP_MIN_BYTES=1024
