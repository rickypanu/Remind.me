# Deadline client - client/.env.example
#
#   cp .env.example .env      (Vite only exposes variables that start with VITE_)
#
# Everything here is PUBLIC: it is compiled into the browser bundle.
# Never put a secret in a VITE_ variable.

# [REQUIRED in production] base URL of the API, no trailing slash. `npm run build` now FAILS if it is not an https URL
# (otherwise the deployed app would call http://localhost:8000). `npm run dev` falls back to http://localhost:8000.
VITE_API_BASE_URL=http://localhost:8000

# [OPTIONAL] VAPID *public* key, same value as VAPID_PUBLIC_KEY on the server.
# Without it the "enable alerts" button reports that push is not configured.
VITE_VAPID_PUBLIC_KEY=

# [OPTIONAL locally, REQUIRED on a real deploy - Vercel supplies VERCEL_PROJECT_PRODUCTION_URL itself] public address of the site, no trailing slash and no path.
# Used at build time for canonical links, Open Graph / Twitter share cards, sitemap.xml and robots.txt
# (crawlers need absolute URLs). On your own computer a missing value falls back to http://localhost:4173 with a warning.
VITE_SITE_URL=https://your-domain.example
